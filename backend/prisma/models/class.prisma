model Class {
    id         Int         @id @default(autoincrement())
    name       String
    allowJoins Boolean     @map("allow_joins")
    joinCode   String?     @unique @map("join_code")
    schoolYear String      @map("school_year")
    status     ClassStatus
    createdAt  DateTime    @default(now()) @map("created_at")
    educatorId Int         @map("educator_id")
    educator   User        @relation(fields: [educatorId], references: [id])

    students           Student[]
    classConfigSetting ClassConfigSetting?
    excuseRequests     ExcuseRequest[]
    attendanceLogs     AttendanceLog[]
    classSchedules     ClassSchedule[]

    @@index([educatorId])
    @@map("classes")
}

enum ClassStatus {
    ACTIVE
    INACTIVE
    ARCHIVED
    SUSPENDED
    COMPLETED
}
