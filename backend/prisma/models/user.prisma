model User {
    id    Int    @id @default(autoincrement())
    email String @unique
    name  String

    avatarUrl String? @map("avatar_url")

    oauthProvider   OAuthProvider @map("oauth_provider")
    oauthProviderId String        @unique @map("oauth_provider_id")
    role            Role

    createdAt DateTime @default(now()) @map("created_at")

    students Student[]
    classes  Class[]
    devices  Device[]

    @@index([oauthProviderId])
    @@map("users")
}

enum OAuthProvider {
    GOOGLE
    GITHUB
    FACEBOOK
}

enum Role {
    ADMIN
    EDUCATOR
    STUDENT
}
